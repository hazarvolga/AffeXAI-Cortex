# WordPress to CMS Migration Configuration

# WordPress XML export file path
WP_XML_PATH=./wordpress-export.xml

# CMS API Configuration
CMS_API_URL=http://localhost:3001/api
CMS_API_KEY=

# MinIO Configuration (relative path strategy)
MINIO_BASE_URL=/media

# Migration Options
DRY_RUN=true
BATCH_SIZE=10

# Logging
LOG_FILE=./logs/migration.log
